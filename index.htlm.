<script>
let youtubeReady=false;
let youtubeWaiters=[];
window.onYouTubeIframeAPIReady=()=>{youtubeReady=true;youtubeWaiters.splice(0).forEach(f=>f())};
function whenYouTubeReady(fn){youtubeReady&&window.YT&&YT.Player?fn():youtubeWaiters.push(fn)}
let activePlayer=null,guardTimer=null;
function captionsOff(player){
 try{player.unloadModule('captions')}catch(e){}
 try{player.unloadModule('cc')}catch(e){}
 try{player.setOption('captions','track',{})}catch(e){}
}
function captionsOn(player){
 try{player.loadModule('captions')}catch(e){}
 try{player.loadModule('cc')}catch(e){}
 try{player.setOption('captions','track',{languageCode:'de'})}catch(e){}
}
function clock(seconds){const s=Math.max(0,Math.round(seconds));return `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`}
function playExcerpt(host,v){
 if(activePlayer&&activePlayer.destroy){try{activePlayer.destroy()}catch(e){}}
 clearInterval(guardTimer);
 const mount=document.createElement('div');host.innerHTML='';host.appendChild(mount);
 whenYouTubeReady(()=>{
  let finished=false;
  const card=host.closest('.card'),range=card.querySelector('.scrub input'),elapsed=card.querySelector('.elapsed'),remaining=card.querySelector('.remaining');
  range.max=v.end-v.start;range.value=0;elapsed.textContent='00:00';remaining.textContent=clock(v.end-v.start);
  activePlayer=new YT.Player(mount,{videoId:v.id,playerVars:{start:v.start,end:v.end,autoplay:1,controls:0,disablekb:1,rel:0,cc_load_policy:0,cc_lang_pref:'de',playsinline:1,origin:window.location.origin},events:{
   onReady:e=>{const playPause=card.querySelector('.play-pause'),ccOn=card.querySelector('.cc-on'),ccOff=card.querySelector('.cc-off');playPause.onclick=()=>{const p=e.target;if(p.getPlayerState()===YT.PlayerState.PLAYING){p.pauseVideo();playPause.textContent='▶ Weiter'}else{if(p.getCurrentTime()<v.start||p.getCurrentTime()>=v.end){finished=false;p.seekTo(v.start,true)}p.playVideo();playPause.textContent='⏸ Pause'}};ccOn.onclick=()=>{captionsOn(e.target);ccOn.classList.add('active');ccOff.classList.remove('active')};ccOff.onclick=()=>{captionsOff(e.target);ccOff.classList.add('active');ccOn.classList.remove('active')};range.oninput=()=>{finished=false;e.target.seekTo(v.start+Number(range.value),true);elapsed.textContent=clock(range.value);remaining.textContent=clock(v.end-v.start-Number(range.value))};e.target.seekTo(v.start,true);e.target.playVideo();guardTimer=setInterval(()=>{const position=Math.max(0,Math.min(v.end-v.start,e.target.getCurrentTime()-v.start));range.value=position;elapsed.textContent=clock(position);remaining.textContent=clock(v.end-v.start-position);if(!finished&&e.target.getCurrentTime()>=v.end-.15){finished=true;clearInterval(guardTimer);e.target.pauseVideo();playPause.textContent='▶ Von Anfang an';range.value=v.end-v.start;elapsed.textContent=clock(v.end-v.start);remaining.textContent='00:00'}},200)},
   onStateChange:e=>{if(e.data===YT.PlayerState.ENDED&&!finished){finished=true;clearInterval(guardTimer)}}
  }});
 });
}
