videos.forEach((v,i)=>{
 const b=document.createElement('button');b.textContent=`Video ${v.n}`;b.onclick=()=>show(i);tabs.appendChild(b);
 const c=document.createElement('section');c.className='card';c.innerHTML=`<h2>${v.n}. ${esc(v.title)}</h2><div class="meta"><span class="tag">${esc(v.source)}</span><span class="tag">Ausschnitt ${v.time}</span><span class="tag">${v.end-v.start} Sekunden</span></div><div class="player"><button class="play">▶ Ausschnitt abspielen</button></div><div class="scrub"><span class="elapsed">00:00</span><input type="range" min="0" value="0" step="1" aria-label="Position innerhalb des Ausschnitts"><span class="remaining">00:00</span></div><div class="video-controls"><button class="video-btn play-pause">⏸ Pause</button><button class="video-btn cc cc-on">CC Untertitel EIN</button><button class="video-btn cc cc-off active">CC Untertitel AUS</button></div><span class="caption-status"><strong>Untertitel:</strong> über die beiden Schaltflächen ein- oder ausschalten.</span><p class="fallback"><a target="_blank" rel="noopener" href="https://www.youtube.com/watch?v=${v.id}&t=${v.start}s">Originalvideo ab ${v.time.split('–')[0]} öffnen</a> · manuell bei ${v.time.split('–')[1]} stoppen.</p><section class="work"><h3>Aufgabe: Richtig oder falsch?</h3><p>Sehen Sie den Ausschnitt zweimal. Entscheiden Sie beim zweiten Sehen, ob die Aussagen richtig oder falsch sind.</p><ol class="statements">${v.q.map((x,j)=>`<li><span class="rf">R ☐ &nbsp; F ☐</span>${j+1}. ${esc(x[0])}</li>`).join('')}</ol><button class="solution-btn">Lösungen für die Lehrkraft anzeigen</button><div class="solutions"><ol>${v.q.map(x=>`<li><strong>${x[1]?'Richtig':'Falsch'}.</strong> ${esc(x[2])}</li>`).join('')}</ol><p class="teacher">Die Begründungen beruhen auf den überprüften deutschen Untertiteln der angegebenen Sequenz.</p></div></section>`;
 c.querySelector('.play').onclick=()=>playExcerpt(c.querySelector('.player'),v);
 c.querySelector('.solution-btn').onclick=e=>{const s=c.querySelector('.solutions');s.classList.toggle('show');e.target.textContent=s.classList.contains('show')?'Lösungen ausblenden':'Lösungen für die Lehrkraft anzeigen'};
 cards.appendChild(c);
});
function show(i){if(activePlayer&&activePlayer.destroy){try{activePlayer.destroy()}catch(e){}}clearInterval(guardTimer);[...tabs.children].forEach((b,j)=>b.classList.toggle('active',i===j));[...cards.children].forEach((c,j)=>c.classList.toggle('active',i===j));window.scrollTo({top:0,behavior:'smooth'})}show(0);
</script>
